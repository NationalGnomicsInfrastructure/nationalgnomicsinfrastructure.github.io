---
import Layout from "../../layouts/Layout.astro";
import CancelDelivery from "../../components/CancelDelivery.astro";
---

<Layout title="Platform Access">
    <div class="page-header">
        <div class="container">
            <h1>Platform Access</h1>
            <p>Welcome to the NGnI analysis and project management portal.</p>
        </div>
    </div>

    <section>
        <div class="container">
            <!-- Pre-launch state (default) -->
            <div
                id="pre-launch"
                style="max-width:640px;margin:0 auto;text-align:center;"
            >
                <div id="delivery-intro" class="alert alert-info">
                    <strong>New delivery.</strong> Select the emoji sequence from
                    your project coordinator to unlock the platform.
                </div>

                <div
                    id="access-code-card"
                    class="card mt-3"
                    style="text-align:left;"
                >
                    <h3>Delivery Sequence</h3>
                    <p class="text-muted" style="font-size:0.9rem;">
                        Pick one emoji in each column.
                    </p>
                    <div class="emoji-grid" id="emoji-grid"></div>
                    <div
                        id="access-code-error"
                        style="display:none;color:#c0392b;font-size:0.85rem;margin-top:0.75rem;"
                    >
                        ❌ Invalid sequence. Please try again.
                    </div>
                    <button
                        id="verify-btn"
                        class="btn btn-primary mt-3"
                        style="font-size:1.1rem;padding:0.9rem 2.5rem;width:100%;"
                    >
                        🔑 Unlock Platform
                    </button>
                </div>

                <div id="agent-auth" class="card mt-3" style="display:none;text-align:left;">
                    <h3>Agent Name</h3>
                    <p class="text-muted" style="font-size:0.9rem;">
                        This name is recorded on your delivery.
                    </p>
                    <div class="form-group">
                        <label for="agent-name">Name</label>
                        <input
                            type="text"
                            id="agent-name"
                            placeholder="e.g. Gardenia Gnomestone"
                        />
                    </div>
                    <button
                        id="agent-btn"
                        class="btn btn-primary mt-3"
                        style="font-size:1.1rem;padding:0.9rem 2.5rem;width:100%;"
                    >
                        Continue
                    </button>
                </div>
            </div>

            <!-- Post-launch state (hidden until button press) -->
            <div
                id="post-launch"
                style="display:none;margin:0 auto;"
            >
                <div class="alert alert-success" style="max-width:888px;margin-left:auto;margin-right:auto;">
                    Welcome, <a href="/platform/profile/" id="display-agent" style="color:inherit;font-weight:inherit;text-decoration:underline;"></a>. Project Delivery <span id="delivery-status">starting</span>.
                </div>
                <div id="delivery-banner" class="alert alert-success" style="display:none;max-width:888px;margin:0.75rem auto 0;text-align:center;font-size:1.1rem;font-weight:600;">
                    ✅ Your project has been delivered. Thank you for participating!
                </div>
                <div id="access-code-banner" class="alert alert-info" style="display:none;max-width:888px;margin:0.75rem auto 0;text-align:center;">
                    🧬 Your access code: <strong id="access-code" style="font-family:var(--font-mono);letter-spacing:0.15em;"></strong> — search it in the Gnomics Database to find your project.
                </div>

                <div class="cards mt-3">
                    <a
                        href="/platform/species-id/"
                        class="card"
                        id="card-species-id"
                        style="text-decoration:none;cursor:pointer;"
                    >
                        <div class="card-icon">🔬</div>
                        <h3>Species Identification</h3>
                        <p>
                            Identify the spirit animal of the Project
                            Coordinator in charge of your delivery project.
                        </p>
                        <span
                            class="btn btn-outline"
                            style="font-size:0.85rem;padding:0.4rem 0.9rem;"
                            >Open Tool →</span
                        >
                    </a>
                    <div id="card-retrieval" class="card" style="display:none;">
                        <div class="card-icon">🎣</div>
                        <h3>Project Retrieval</h3>
                        <p>
                            Crack the pipeline access code to recover your
                            project.
                        </p>
                        <span
                            class="btn btn-outline"
                            style="font-size:0.85rem;padding:0.4rem 0.9rem;"
                            >Open Tool →</span
                        >
                    </div>
                    <a
                        href="/platform/detangling/"
                        class="card"
                        id="card-next"
                        style="display:none;text-decoration:none;cursor:pointer;"
                    >
                        <div class="card-icon">✂️</div>
                        <h3>Project Detangling</h3>
                        <p>
                            Untangle the knot to continue your delivery.
                        </p>
                        <span
                            class="btn btn-outline"
                            style="font-size:0.85rem;padding:0.4rem 0.9rem;"
                            >Open Tool →</span
                        >
                    </a>
                    <div id="card-project-id" class="card" style="display:none;">
                        <div class="card-icon">🔍</div>
                        <h3>Project Identification</h3>
                        <p>
                            Transform your animal and pipeline into DNA and
                            identify the other strand.
                        </p>
                        <span
                            class="btn btn-outline"
                            style="font-size:0.85rem;padding:0.4rem 0.9rem;"
                            >Open Tool →</span
                        >
                    </div>
                    <div id="card-delivery" class="card" style="display:none;">
                        <div class="card-icon">📮</div>
                        <h3>Project Delivery</h3>
                        <p>
                            Find your project in the database and deliver it.
                        </p>
                        <span
                            class="btn btn-outline"
                            style="font-size:0.85rem;padding:0.4rem 0.9rem;"
                            >Open Tool →</span
                        >
                    </div>
                </div>
                <CancelDelivery />
            </div>
        </div>
    </section>
</Layout>

<script>
    import { KEYS, COMBO_KEY, accessCode, experience, sha256 } from "../../lib/platform";
    import { UNLOCK_HASHES, UNIVERSAL_UNLOCK_HASH, PROJECT_COUNT, RETRIEVAL_ANSWERS_ENC, decodeAnswerList } from "../../lib/platform-content";

    // 5 columns × 4 rows: animal | plant | color | space | science.
    const EMOJI_COLUMNS = [
        ["🦭", "🐍", "🦎", "🦉"],
        ["🍄", "🌵", "🌲", "🌸"],
        ["🔴", "🟠", "🟢", "🔵"],
        ["🌍", "🌙", "⭐", "🪐"],
        ["🧬", "🔬", "🧪", "⚗️"],
    ] as const;

    // Ordered delivery pipeline. Step i is visible once step i-1 is done.
    const steps = [
        { id: "card-species-id", doneKey: KEYS.speciesDone, href: "/platform/species-id/" },
        { id: "card-retrieval", doneKey: KEYS.accession, href: "/platform/retrieval/" },
        { id: "card-next", doneKey: KEYS.detangled, href: "/platform/detangling/" },
        { id: "card-project-id", doneKey: KEYS.identificationDone, href: "/platform/identification/" },
        { id: "card-delivery", doneKey: KEYS.deliveryDone, href: "/platform/delivery/" },
    ] as const;

    const verifyBtn = document.getElementById("verify-btn");
    const preLaunch = document.getElementById("pre-launch");
    const postLaunch = document.getElementById("post-launch");
    const codeCard = document.getElementById("access-code-card");
    const codeError = document.getElementById("access-code-error");
    const emojiGrid = document.getElementById("emoji-grid");
    const deliveryIntro = document.getElementById("delivery-intro");
    const agentAuth = document.getElementById("agent-auth");
    const agentBtn = document.getElementById("agent-btn");
    const agentInput = document.getElementById(
        "agent-name",
    ) as HTMLInputElement;
    const displayAgent = document.getElementById("display-agent");

    const selected: (number | null)[] = [null, null, null, null, null];

    const done = (key: string) => Boolean(localStorage.getItem(key));

    function applyStepState() {
        steps.forEach((step, i) => {
            const card = document.getElementById(step.id);
            if (!card) return;
            const visible = i === 0 || done(steps[i - 1].doneKey);
            if (!visible) {
                card.style.display = "none";
                return;
            }
            card.style.display = "block";
            if (done(step.doneKey)) {
                card.style.cursor = "default";
                card.style.opacity = "0.5";
                if (card instanceof HTMLAnchorElement) card.removeAttribute("href");
                card.onclick = null;
                const btn = card.querySelector(".btn");
                if (btn) btn.textContent = "✅ Completed";
                return;
            }
            if (i === 0) return;
            card.style.cursor = "pointer";
            card.onclick = () => {
                window.location.href = step.href;
            };
        });

        const status = document.getElementById("delivery-status");
        if (status && (done(KEYS.speciesDone) || done(KEYS.accession))) {
            status.textContent = "ongoing";
        }
        if (done(KEYS.deliveryDone)) {
            if (status) status.textContent = "completed";
            const banner = document.getElementById("delivery-banner");
            if (banner) banner.style.display = "block";
        }
        if (done(KEYS.identificationDone)) {
            const animal = localStorage.getItem(KEYS.spiritAnimal) ?? "";
            const pipeline = decodeAnswerList(RETRIEVAL_ANSWERS_ENC)[experience().pipelineIdx];
            const codeEl = document.getElementById("access-code");
            if (codeEl) codeEl.textContent = accessCode(animal, pipeline);
            const banner = document.getElementById("access-code-banner");
            if (banner) banner.style.display = "block";
        }
    }

    function showPlatform() {
        if (preLaunch) preLaunch.style.display = "none";
        if (postLaunch) postLaunch.style.display = "block";
        if (displayAgent) {
            displayAgent.textContent =
                localStorage.getItem(KEYS.agent) || "you";
        }
        applyStepState();
    }

    function showAgentAuth() {
        if (codeCard) codeCard.style.display = "none";
        if (deliveryIntro) deliveryIntro.style.display = "none";
        if (agentAuth) agentAuth.style.display = "block";
    }

    function selectEmoji(colIdx: number, rowIdx: number, btn: HTMLButtonElement) {
        selected[colIdx] = rowIdx;
        const col = btn.parentElement;
        if (!col) return;
        col.querySelectorAll(".emoji-option").forEach((el) => {
            el.classList.remove("selected");
            el.setAttribute("aria-pressed", "false");
        });
        btn.classList.add("selected");
        btn.setAttribute("aria-pressed", "true");
    }

    function buildEmojiGrid() {
        if (!emojiGrid) return;
        EMOJI_COLUMNS.forEach((emojis, colIdx) => {
            const colEl = document.createElement("div");
            colEl.className = "emoji-col";

            emojis.forEach((emoji, rowIdx) => {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "emoji-option";
                btn.textContent = emoji;
                btn.setAttribute(
                    "aria-label",
                    "Column " + (colIdx + 1) + ", row " + (rowIdx + 1),
                );
                btn.setAttribute("aria-pressed", "false");
                btn.addEventListener("click", () => selectEmoji(colIdx, rowIdx, btn));
                colEl.appendChild(btn);
            });

            emojiGrid.appendChild(colEl);
        });
    }

    buildEmojiGrid();

    const hasUnlock =
        Boolean(localStorage.getItem(KEYS.codeIdx)) ||
        localStorage.getItem(KEYS.mode) === "random";
    const hasAgent = Boolean(localStorage.getItem(KEYS.agent));
    if (hasUnlock && hasAgent) {
        showPlatform();
    } else if (hasUnlock) {
        showAgentAuth();
    }

    verifyBtn?.addEventListener("click", async () => {
        if (selected.some((v) => v === null)) {
            if (codeError) codeError.style.display = "block";
            return;
        }
        const hash = await sha256(selected.join(","));
        if (codeError) codeError.style.display = "none";
        if (hash === UNIVERSAL_UNLOCK_HASH) {
            localStorage.setItem(KEYS.mode, "random");
            // Fresh combo on every unlock: cancel and replay = new experience.
            const a = Math.floor(Math.random() * PROJECT_COUNT);
            const p = Math.floor(Math.random() * PROJECT_COUNT);
            localStorage.setItem(COMBO_KEY, `${a}:${p}`);
            showAgentAuth();
            return;
        }
        const idx = UNLOCK_HASHES.indexOf(
            hash as (typeof UNLOCK_HASHES)[number],
        );
        if (idx === -1) {
            if (codeError) codeError.style.display = "block";
            return;
        }
        localStorage.setItem(KEYS.codeIdx, String(idx));
        showAgentAuth();
    });

    function submitAgent() {
        const name = agentInput?.value.trim();
        if (!name) {
            alert("Enter the name to record on your delivery.");
            return;
        }
        localStorage.setItem(KEYS.agent, name);
        showPlatform();
    }

    agentBtn?.addEventListener("click", submitAgent);
    agentInput?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") submitAgent();
    });
</script>
