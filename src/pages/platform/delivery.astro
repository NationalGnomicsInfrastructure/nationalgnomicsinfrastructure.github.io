---
import Layout from '../../layouts/Layout.astro';
import CancelDelivery from '../../components/CancelDelivery.astro';
---
<Layout title="Project Delivery">

  <div class="page-header">
    <div class="container">
      <h1>Project Delivery</h1>
      <p>Find your project in the database, then deliver it.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="submit-form">

        <div class="alert alert-info mb-2">
          <strong>Project delivery.</strong><br/>
          Enter the project name exactly as it appears in the database.
        </div>

        <div id="form-area">
          <div class="form-group">
            <label for="project-name">Project</label>
            <input type="text" id="project-name" placeholder="Enter the project" autocomplete="off" style="font-size:1.1rem;" />
          </div>
          <button class="btn btn-primary" id="submit-btn" style="width:100%;padding:0.75rem;">
            Deliver Project
          </button>
        </div>

        <div id="error-msg" style="display:none;" class="alert alert-warning mt-2">
          That's not the right project. Look again in the database.
        </div>

        <div id="result-area" style="display:none;" class="success-box">
          <h3>Project delivered.</h3>
          <p id="delivered-name"></p>
          <a href="/platform/" class="btn btn-primary mt-2">Back to Platform</a>
        </div>

      </div>
      <CancelDelivery />
    </div>
  </section>
</Layout>

<script>
import { KEYS, codeIdx, onForm, requireFlag, sha256 } from '../../lib/platform';
import { PROJECT_HASHES } from '../../lib/platform-content';

requireFlag(KEYS.identificationDone);
const idx = codeIdx(PROJECT_HASHES.length);
onForm({
  inputId: 'project-name',
  doneKey: KEYS.deliveryDone,
  check: async (value) => (await sha256(value.trim())) === PROJECT_HASHES[idx],
  onSuccess: () => {
    const name = (document.getElementById('project-name') as HTMLInputElement).value.trim();
    if (!name) return; // restore path: input is empty, keep the stored name
    localStorage.setItem(KEYS.deliveredName, name);
    const nameEl = document.getElementById('delivered-name');
    if (nameEl) nameEl.textContent = name;
  },
});
if (localStorage.getItem(KEYS.deliveryDone)) {
  const nameEl = document.getElementById('delivered-name');
  if (nameEl) nameEl.textContent = localStorage.getItem(KEYS.deliveredName) ?? '';
}
</script>
