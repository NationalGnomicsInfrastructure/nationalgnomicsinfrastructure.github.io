---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Project Retrieval">

  <div class="page-header">
    <div class="container">
      <h1>Project Retrieval</h1>
      <p>Recover your project with the spirit animal from Species Identification.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="submit-form">

        <div class="alert alert-info mb-2">
          <strong>Project retrieval.</strong><br/>
          Enter the spirit animal from Species Identification to recover your project.
        </div>

        <div id="form-area">
          <div class="form-group">
            <label for="spirit-animal">Spirit Animal</label>
            <input type="text" id="spirit-animal" placeholder="Enter the spirit animal" autocomplete="off" style="font-size:1.1rem;" />
          </div>
          <button class="btn btn-primary" id="submit-btn" style="width:100%;padding:0.75rem;">
            Recover Project
          </button>
        </div>

        <div id="error-msg" style="display:none;" class="alert alert-warning mt-2">
          That's not the Project Coordinator's spirit animal. Try again.
        </div>

        <div id="result-area" style="display:none;">
          <div class="alert alert-success">
            Project retrieved. Your delivery continues.
          </div>
          <div class="card mt-3" style="padding:1.25rem;">
            <p style="font-style:italic;font-size:1.1rem;line-height:1.6;">
              "The language of life has many words but a small alphabet,
              my count is the envelope you need."
            </p>
            <p class="text-muted mt-2" style="font-size:0.9rem;">
              Find the envelope with that number and open it to continue your delivery.
            </p>
            <a href="/platform/" class="btn btn-primary mt-2">Back to Platform</a>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
import { KEYS, onForm, requireFlag } from '../../lib/platform';

requireFlag(KEYS.spiritAnimal);
const animal = localStorage.getItem(KEYS.spiritAnimal)!;
onForm({
  inputId: 'spirit-animal',
  doneKey: KEYS.accession,
  check: (value) => value.trim().toLowerCase() === animal,
});
</script>
