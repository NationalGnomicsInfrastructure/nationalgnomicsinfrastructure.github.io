<div id="cancel-delivery" style="margin:1.5rem auto 0;text-align:center;">
  <button id="disconnect-btn" class="btn btn-cancel-delivery">🚫 Cancel Delivery</button>
</div>

<script>
    import { KEYS, disconnect } from "../lib/platform";
    const btn = document.getElementById("disconnect-btn") as HTMLButtonElement;
    const delivered = Boolean(localStorage.getItem(KEYS.deliveryDone));
    if (delivered) btn.textContent = "🔌 Disconnect";
    btn.addEventListener("click", () => {
        const msg = delivered
            ? "Clear this session and start over?"
            : "⚠️ This will cancel your delivery and clear all progress. Are you sure?";
        if (!confirm(msg)) return;
        disconnect();
    });
</script>
