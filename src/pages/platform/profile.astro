---
import Layout from '../../layouts/Layout.astro';
import CancelDelivery from '../../components/CancelDelivery.astro';
---
<Layout title="Delivery Card">

  <div class="page-header">
    <div class="container">
      <h1>Delivery Card</h1>
      <p>Your NGnI coordinator status card.</p>
    </div>
  </div>

  <section>
    <div class="container" style="max-width:640px;margin:0 auto;">

      <div class="accession-card" style="margin-bottom:1.5rem;">
        <div style="display:flex;gap:1rem;align-items:center;margin-bottom:1rem;">
          <div style="font-size:3rem;">🧬</div>
          <div>
            <h3 id="p-agent" style="margin:0;">—</h3>
            <p class="text-muted" style="margin:0;font-size:0.9rem;">Project Delivery Agent</p>
          </div>
        </div>
        <table>
          <tr id="p-animal-row" style="display:none;"><td><i class="fa-solid fa-dna"></i> Spirit animal</td><td id="p-animal">—</td></tr>
          <tr id="p-pipeline-row" style="display:none;"><td><i class="fa-solid fa-diagram-project"></i> Pipeline</td><td id="p-pipeline">—</td></tr>
          <tr id="p-code-row" style="display:none;"><td><i class="fa-solid fa-key"></i> Access code</td><td id="p-code" style="font-family:var(--font-mono);letter-spacing:0.15em;">—</td></tr>
          <tr id="p-socks-row"><td><button type="button" id="p-sock-icon" aria-label="Decorative sock — not part of the hunt" style="background:none;border:none;padding:0;cursor:pointer;line-height:0;"><img src="/sock.png" alt="" width="15" height="15" style="vertical-align:-0.15em;" /></button> Socks</td><td><div id="p-socks">—</div><button type="button" id="p-socks-reset" class="btn btn-outline" style="margin-top:0.35rem;font-size:0.75rem;padding:0.25rem 0.6rem;">🥐 Clean croissants</button></td></tr>
          <tr id="p-project-row" style="display:none;"><td><i class="fa-solid fa-box"></i> Project</td><td id="p-project">—</td></tr>
        </table>
        <h4 id="p-progress-title" style="margin-top:1.25rem;font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;opacity:0.7;">Delivery progress</h4>
        <ul id="p-progress" style="list-style:none;padding:0;margin:0.5rem 0 0;"></ul>
      </div>

      <div style="text-align:center;">
        <a href="/platform/" class="btn btn-outline">← Back to Platform</a>
      </div>
      <CancelDelivery />

    </div>
  </section>
</Layout>

<script>
import { KEYS, accessCode, randomPick } from '../../lib/platform';
import { PROJECT_COUNT, RETRIEVAL_ANSWERS_ENC, decodeAnswerList } from '../../lib/platform-content';
import { SOCKS_KEY, SOCK_TOTAL, foundSocks, sockToast } from '../../lib/socks';

const done = (key: string) => Boolean(localStorage.getItem(key));
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const set = (id: string, text: string) => {
  const el = document.getElementById(id);
  if (el) el.textContent = text;
};

// Locked fields stay hidden until their step reveals them in-game —
// the page never redirects, it just shows what the player knows so far.
set('p-agent', localStorage.getItem(KEYS.agent) ?? '—');

if (done(KEYS.speciesDone)) {
  const animal = localStorage.getItem(KEYS.spiritAnimal) ?? '';
  if (animal) {
    set('p-animal', cap(animal));
    const row = document.getElementById('p-animal-row');
    if (row) row.style.display = '';
  }
}

const pick = randomPick();
const idxRaw = parseInt(localStorage.getItem(KEYS.codeIdx) ?? '', 10);
const hasIdx = !Number.isNaN(idxRaw) && idxRaw >= 0 && idxRaw < PROJECT_COUNT;
const pipelineIdx = pick ? pick.pipelineIdx : hasIdx ? idxRaw : null;
if (done(KEYS.accession) && pipelineIdx !== null) {
  set('p-pipeline', decodeAnswerList(RETRIEVAL_ANSWERS_ENC)[pipelineIdx]);
  const row = document.getElementById('p-pipeline-row');
  if (row) row.style.display = '';
}

if (done(KEYS.identificationDone) && pipelineIdx !== null) {
  const animal = localStorage.getItem(KEYS.spiritAnimal) ?? '';
  const pipeline = decodeAnswerList(RETRIEVAL_ANSWERS_ENC)[pipelineIdx];
  set('p-code', accessCode(animal, pipeline));
  const row = document.getElementById('p-code-row');
  if (row) row.style.display = '';
}

const project = localStorage.getItem(KEYS.deliveredName);
if (done(KEYS.deliveryDone) && project) {
  set('p-project', project);
  const row = document.getElementById('p-project-row');
  if (row) row.style.display = '';
}

const socks = foundSocks();
const socksRow = document.getElementById('p-socks-row');
if (socks.length === 0) {
  if (socksRow) socksRow.style.display = 'none';
} else {
  set(
    'p-socks',
    socks.length >= SOCK_TOTAL
      ? `${SOCK_TOTAL} / ${SOCK_TOTAL} — all found!`
      : `${socks.length} / ${SOCK_TOTAL}`,
  );
}

document.getElementById('p-sock-icon')?.addEventListener('click', () => {
  sockToast('Not part of the sock hunt.');
});

document.getElementById('p-socks-reset')?.addEventListener('click', () => {
  if (!confirm('Reset the sock hunt? All found socks will be forgotten.')) return;
  localStorage.removeItem(SOCKS_KEY);
  if (socksRow) socksRow.style.display = 'none';
  sockToast('Sock hunt reset. The croissants are clean.');
});

const steps = [
  { label: 'Species identification', key: KEYS.speciesDone },
  { label: 'Project retrieval', key: KEYS.accession },
  { label: 'Project detangling', key: KEYS.detangled },
  { label: 'Project identification', key: KEYS.identificationDone },
  { label: 'Project delivery', key: KEYS.deliveryDone },
];
const earnedSteps = steps.filter((s) => done(s.key));
if (earnedSteps.length === 0) {
  const title = document.getElementById('p-progress-title');
  if (title) title.style.display = 'none';
} else {
  const list = document.getElementById('p-progress');
  for (const s of earnedSteps) {
    const li = document.createElement('li');
    li.style.padding = '0.35rem 0';
    li.textContent = `✅ ${s.label}`;
    list?.appendChild(li);
  }
}
</script>
