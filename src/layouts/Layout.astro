---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "National Gnomics Infrastructure — Advancing gnome-scale genomic discovery" } = Astro.props;
const siteTitle = "National Gnomics Infrastructure";
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#104827" />
  <link rel="canonical" href={pageUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={siteTitle} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageUrl} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
    integrity="sha384-rWj9FmWWt3OMqd9vBkWRhFavvVUYalYqGPoMdL1brs/qvvqz88gvLShYa4hKNyqb"
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />
  <meta name="generator" content={Astro.generator} />
  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; img-src 'self' data:; font-src https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self'; frame-src 'none'; object-src 'none'"
  />
  <title>{title} | NGnI</title>
  <script is:inline src="/js/theme-init.js"></script>
  <script is:inline src="/js/nav.js"></script>
</head>
<body>

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="redirect-banner">
  🧬 Looking for the <strong>real</strong> National Genomics Infrastructure?
  Visit <a href="https://ngisweden.scilifelab.se/" target="_blank" rel="noopener">ngisweden.scilifelab.se</a>
</div>

<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href="/" class="site-logo">
      <img src="/ngni-logo.png" alt="NGnI" style="height:2.8rem;vertical-align:middle;" />
      <span>National Gnomics Infrastructure</span>
    </a>
    <button class="burger" id="burger" aria-label="Toggle navigation" aria-expanded="false">
      <span class="burger-bar"></span>
      <span class="burger-bar"></span>
      <span class="burger-bar"></span>
    </button>
    <nav id="nav">
      <a href="/applications/">Applications</a>
      <a href="/technologies/">Technologies</a>
      <a href="/database/">Database</a>
      <a href="/platform/">Platform</a>
      <a href="/about/">About</a>
      <div class="theme-dropdown">
        <button
          id="theme-toggle"
          type="button"
          title="Select theme"
          aria-label="Select theme"
        >
          <i class="fa-solid fa-moon" aria-hidden="true"></i>
        </button>
        <div class="theme-dropdown-menu">
          <button class="theme-option" data-theme="light">
            <i class="fa-solid fa-sun" aria-hidden="true"></i> Light
          </button>
          <button class="theme-option" data-theme="dark">
            <i class="fa-solid fa-moon" aria-hidden="true"></i> Dark
          </button>
          <button class="theme-option" data-theme="auto">
            <i class="fa-solid fa-adjust" aria-hidden="true"></i> System
          </button>
        </div>
      </div>
    </nav>
  </div>
</header>

<main id="main-content">
<slot />
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-col" style="text-align:center;">
        <h4>NGnI</h4>
        <div style="display:flex;align-items:center;justify-content:center;gap:0.75rem;margin-top:0.75rem;">
          <a href="https://github.com/NationalGnomicsInfrastructure" target="_blank" rel="noopener">
            <img src="/ngni-logo.png" alt="NGnI" style="height:3.5rem;opacity:0.85;" />
          </a>
          <a href="https://github.com/SciFiLab" target="_blank" rel="noopener">
            <img src="/scifilab-symbol.svg" alt="SciFiLab" style="height:3.5rem;opacity:0.85;" />
          </a>
        </div>
        <p style="font-size:0.85rem;line-height:1.5;margin-top:0.75rem;">Part of the Gnomics Platform at SciFiLab.</p>
      </div>
      <div class="footer-col" style="max-width:300px;">
        <h4>Applications</h4>
        <ul style="display:grid;grid-template-columns:1fr 1fr;gap:0.15rem 0.75rem;">
          <li><a href="/applications/gnome-sequencing/">Gnome Sequencing</a></li>
          <li><a href="/applications/spatial-gnomics/">Spatial Gnomics</a></li>
          <li><a href="/applications/ancient-gnomics/">Ancient Gnomics</a></li>
          <li><a href="/applications/mycognomics/">Mycognomics</a></li>
          <li><a href="/applications/epignomics/">Epignomics</a></li>
          <li><a href="/applications/pharmagnomics/">Pharmagnomics</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Resources</h4>
        <ul>
          <li><a href="/platform/">Platform</a></li>
          <li><a href="/database/">Database</a></li>
          <li><a href="https://github.com/NationalGnomicsInfrastructure/crepes">Pipeline Code</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>About</h4>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/about/#contact">Contact form</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 National Gnomics Infrastructure, SciFiLab</span>
      <span>Gnomenhavn, Listenbourg</span>
    </div>
  </div>
</footer>

<script is:inline src="/js/theme.js"></script>
</body>
</html>
