---
import Layout from '../../layouts/Layout.astro';
import CancelDelivery from '../../components/CancelDelivery.astro';
import '../../styles/retrieval.css';
---
<Layout title="Project Retrieval">

  <div class="page-header">
    <div class="container">
      <h1>Project Retrieval</h1>
      <p>Recover your project by cracking the Project Coordinator's pipeline access code.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="submit-form">

        <div class="alert alert-info mb-2">
          <strong>Pipeline access code.</strong><br/>
          Guess the nf-core pipeline that unlocks your project.
          Green = right letter, right spot. Yellow = right letter, wrong spot.
        </div>

        <div id="form-area">
          <div id="guess-grid" class="wr-grid"></div>
          <div class="wr-input-row">
            <input type="text" id="pipeline-input" placeholder="Enter a pipeline name…" autocomplete="off" maxlength="11" />
            <button class="btn btn-primary" id="guess-btn">Guess</button>
          </div>
          <div id="error-msg" style="display:none;" class="alert alert-warning mt-2"></div>
        </div>

        <div id="result-area" style="display:none;" class="success-box">
          <div style="font-size:3rem;">🎉</div>
          <h3>Project Retrieved!</h3>
          <p>Your delivery continues.</p>
          <a href="/platform/" class="btn btn-primary mt-2">Proceed to Next Task →</a>
        </div>

      </div>
      <CancelDelivery />
    </div>
  </section>
</Layout>

<script>
import { KEYS, experience, requireFlag, sha256 } from '../../lib/platform';
import {
  RETRIEVAL_ANSWERS_ENC,
  RETRIEVAL_ANSWER_HASHES,
  decodeAnswerList,
} from '../../lib/platform-content';

requireFlag(KEYS.spiritAnimal);

const answers = decodeAnswerList(RETRIEVAL_ANSWERS_ENC);
const exp = experience();
const answer = answers[exp.pipelineIdx];
const answerHash = RETRIEVAL_ANSWER_HASHES[exp.pipelineIdx];

const input = document.getElementById('pipeline-input') as HTMLInputElement;
const btn = document.getElementById('guess-btn') as HTMLButtonElement;
const grid = document.getElementById('guess-grid') as HTMLDivElement;
const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
const resultArea = document.getElementById('result-area') as HTMLDivElement;

let guesses: string[] = (() => {
  try {
    const raw = localStorage.getItem(KEYS.retrievalGuesses);
    const arr = raw ? (JSON.parse(raw) as string[]) : [];
    return arr.filter((g) => typeof g === 'string' && g.length > 0);
  } catch {
    return [];
  }
})();

function scoreGuess(guess: string): string[] {
  const res: string[] = Array(guess.length).fill('absent');
  const remaining: Record<string, number> = {};
  for (let i = 0; i < answer.length; i++) {
    if (guess[i] === answer[i]) res[i] = 'correct';
    else remaining[answer[i]] = (remaining[answer[i]] ?? 0) + 1;
  }
  for (let i = 0; i < guess.length; i++) {
    if (res[i] === 'correct') continue;
    if (remaining[guess[i]] > 0) {
      res[i] = 'present';
      remaining[guess[i]]--;
    }
  }
  return res;
}

function renderRow(guess: string, width: number): HTMLDivElement {
  const row = document.createElement('div');
  row.className = 'wr-row';
  row.style.setProperty('--cols', String(width));
  const states = scoreGuess(guess);
  guess.split('').forEach((ch, i) => {
    const tile = document.createElement('div');
    tile.className = `wr-tile wr-tile-${states[i]}`;
    tile.textContent = ch;
    row.appendChild(tile);
  });
  for (let i = guess.length; i < width; i++) {
    const tile = document.createElement('div');
    tile.className = 'wr-tile wr-tile-absent';
    tile.textContent = '?';
    row.appendChild(tile);
  }
  return row;
}

function renderGrid(): void {
  grid.innerHTML = '';
  if (guesses.length === 0) {
    const row = document.createElement('div');
    row.className = 'wr-row';
    row.style.setProperty('--cols', '5');
    for (let i = 0; i < 5; i++) {
      const tile = document.createElement('div');
      tile.className = 'wr-tile wr-tile-absent';
      tile.textContent = '?';
      row.appendChild(tile);
    }
    grid.appendChild(row);
    return;
  }
  const width = Math.max(...guesses.map((g) => g.length));
  for (const g of guesses) grid.appendChild(renderRow(g, width));
}

function showResult(): void {
  (document.querySelector('.wr-input-row') as HTMLElement).style.display = 'none';
  errorMsg.style.display = 'none';
  resultArea.style.display = 'block';
}

function showError(msg: string): void {
  errorMsg.textContent = msg;
  errorMsg.style.display = 'block';
}

async function submitGuess(): Promise<void> {
  const val = input.value.trim().toLowerCase();
  if (!val) return;
  if (guesses.includes(val)) {
    showError('You already tried that one.');
    return;
  }
  errorMsg.style.display = 'none';
  guesses.push(val);
  localStorage.setItem(KEYS.retrievalGuesses, JSON.stringify(guesses));
  input.value = '';
  renderGrid();
  if ((await sha256(val)) === answerHash) {
    localStorage.setItem(KEYS.accession, '1');
    showResult();
  }
}

btn.addEventListener('click', () => void submitGuess());
input.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') void submitGuess();
});

if (localStorage.getItem(KEYS.accession)) {
  renderGrid();
  showResult();
} else {
  renderGrid();
}
</script>
